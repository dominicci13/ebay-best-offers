# =============================================================================
# ebay-best-offers — copy to .env and fill in real values (.env is gitignored).
# Business tunables (commission, min profit floors, discount band, shipping floor)
# are NOT here — they live in the control workbook (Best-Offers-Settings.xlsx).
# =============================================================================

# --- eBay Trading API: app keyset (ONE app covers ALL accounts) -----------
# developer.ebay.com -> Application Keysets -> Production.
EBAY_APP_ID=your_app_id
EBAY_DEV_ID=your_dev_id
EBAY_CERT_ID=your_cert_id

# --- eBay Trading API: one user token per seller account -------------------
# developer.ebay.com -> User Tokens -> "Sign in to Production" as each account.
# Var name = EBAY_AUTH_TOKEN_ + the account name with letters/digits only, uppercased
# (e.g. "Some Account-1" -> EBAY_AUTH_TOKEN_SOMEACCOUNT1). One per seller account.
EBAY_AUTH_TOKEN_ACCOUNT1=
EBAY_AUTH_TOKEN_ACCOUNT2=
EBAY_AUTH_TOKEN_ACCOUNT3=
EBAY_AUTH_TOKEN_ACCOUNT4=

# --- Acting on offers (SAFETY GATE) ---------------------------------------
# Leave false: the run DECIDES and RECORDS every offer but does NOT answer it on
# eBay (dry run — it only logs the Accept/Counter/Decline it would send).
# Set to true ONLY after the business signs off, to send real responses to buyers.
ACT_ON_OFFERS=false

# --- Alerting -------------------------------------------------------------
# Outlook account for crash reports (screenshot + traceback) on failure.
ALERT_EMAIL=alerts@example.com

# --- Email report ---------------------------------------------------------
# Outlook account the summary email is sent from.
SENDER_EMAIL=sender@example.com
# Recipient(s) of the summary email, comma-separated. Blank = SENDER_EMAIL.
TO_EMAIL=recipient@example.com
# Optional CC recipient(s), comma-separated. Leave blank for none.
CC_EMAIL=cc@example.com

# --- Settings-error alerts ------------------------------------------------
# Business recipient(s) of the plain-language "fix the settings workbook" email.
SETTINGS_ALERT_TO=owner@example.com,manager@example.com
# Optional BCC (e.g. the developer). Leave blank for none.
SETTINGS_ALERT_BCC=developer@example.com