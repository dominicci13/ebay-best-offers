# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc

# Logs and outputs — keep folder structure visible, ignore content
logs/*
!logs/.gitkeep
output/*
!output/.gitkeep
# SeleniumBase deletes this folder on every startup, so a tracked
# placeholder cannot survive. Nothing reads it.
downloaded_files/

# Screenshots — ignore everything except .gitkeep so the folder is tracked
screenshots/*
!screenshots/.gitkeep

# Local config / secrets
config/*.json
!config/*.json.example
.env

# Build artifacts
*.egg-info/
dist/
build/

# Working artifacts
tasks/
.claude/
.claude-flow/
CLAUDE.md
*.db

# Data files
*.xlsx
*.xls
*.xlsm
*.csv

# OS junk
.DS_Store

# Pytest cache / coverage
.pytest_cache/
.coverage
